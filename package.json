{
  "name": "singapore-space-atlas",
  "version": "1.0.0",
  "description": "Singapore Space Atlas — a visual, evidence-backed systems map of Singapore's space ecosystem.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/radc4t/singapore-space-atlas",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "node scripts/validate-data.mjs",
    "stress": "node scripts/layout-stress.mjs",
    "build": "node scripts/build.mjs",
    "preview": "npm run build && serve dist",
    "dev": "python3 scripts/nocache_server.py",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,html,md,json}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.62.1",
    "d3-shape": "^3.2.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "serve": "^14.2.4"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  }
}
